.menu-page {
  padding: 20rpx;
  background-color: #F5F5F5;
  min-height: 100vh;
}

.header-info {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10rpx;
}

.left-action {
  flex: 1;
}

.import-btn {
  background-color: #28a745;
  color: white;
  font-size: 24rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
}

.count-text {
  color: #666;
  font-size: 28rpx;
}

.dish-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48%; /* 2-column grid */
  margin-bottom: 20rpx;
}

.fab {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #FF7F50;
  border-radius: 50%;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 127, 80, 0.4);
  z-index: 100;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 200;
}

.modal-content {
  background-color: white;
  width: 80%;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
  box-sizing: border-box;
}

.modal-header {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.form-group {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input-field {
  width: 100%;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input-area {
  width: 100%;
  height: 150rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  margin-right: 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.btn {
  width: 45%;
  font-size: 30rpx;
  padding: 10rpx 0;
  border-radius: 10rpx;
}

.cancel {
  background-color: #f0f0f0;
  color: #666;
}

.save {
  background-color: #FF7F50;
  color: white;
}

.image-uploader {
  width: 150rpx;
  height: 150rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border: 2rpx dashed #ccc;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.placeholder {
  font-size: 24rpx;
  color: #999;
}
