.role-select {
  padding: 40rpx;
  background-color: #FFF8E1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.header {
  margin-bottom: 80rpx;
  text-align: center;
}

.title {
  font-size: 60rpx;
  font-weight: bold;
  color: #FF7F50;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #888;
}

.btn-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.role-btn {
  display: flex;
  align-items: center;
  width: 80%;
  margin-bottom: 40rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  border: none;
  background: white;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.05);
  transition: transform 0.1s;
}

.role-btn:active {
  transform: scale(0.98);
}

.icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.text-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.main-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.sub-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 5rpx;
}

.child-btn {
  background-color: #E3F2FD; /* Light Blue */
  border: 2rpx solid #BBDEFB;
}

.mom-btn {
  background-color: #FFEBEE; /* Light Pink */
  border: 2rpx solid #FFCDD2;
}

.summary-btn {
  background-color: #E8F5E9; /* Light Green */
  border: 2rpx solid #C8E6C9;
}
