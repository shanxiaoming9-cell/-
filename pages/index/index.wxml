<view class="container role-select">
  <view class="header">
    <text class="title">今天吃什么？</text>
    <text class="subtitle">Family Meal Picker</text>
  </view>

  <view class="btn-group">
    <button class="role-btn child-btn" bindtap="navToChild">
      <view class="icon-wrap child-icon-bg">
        <text class="icon-emoji">👶</text>
      </view>
      <view class="text-group">
        <text class="main-text">我是宝宝</text>
        <text class="sub-text">去点餐</text>
      </view>
    </button>

    <button class="role-btn mom-btn" bindtap="navToMom">
      <view class="icon-wrap mom-icon-bg">
        <text class="icon-emoji">👩‍🍳</text>
      </view>
      <view class="text-group">
        <text class="main-text">我是妈妈</text>
        <text class="sub-text">管理菜谱</text>
      </view>
    </button>

    <button class="role-btn summary-btn" bindtap="navToSummary">
      <view class="icon-wrap summary-icon-bg">
        <text class="icon-emoji">📅</text>
      </view>
      <view class="text-group">
        <text class="main-text">今日菜单</text>
        <text class="sub-text">感谢妈妈</text>
      </view>
    </button>
  </view>
</view>
