<view class="dish-card {{selected ? 'selected' : ''}}" bindtap="onTap">
  <image class="dish-image" src="{{dish.image}}" mode="aspectFill"></image>
  <view class="dish-info">
    <text class="dish-name">{{dish.name}}</text>
    <view wx:if="{{dish.url}}" class="link-btn" catchtap="copyLink">🔗 做法</view>
  </view>
  <view wx:if="{{selected}}" class="check-mark">✓</view>
</view>
